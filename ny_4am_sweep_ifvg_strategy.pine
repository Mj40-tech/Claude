//@version=6
// ══════════════════════════════════════════════════════════════════════════════
//  4AM Range Sweep + 15m PD Array + IFVG
// ──────────────────────────────────────────────────────────────────────────────
//  The checklist this script automates (all times New York):
//
//    03:55   Mark the nearest 15-minute PD array above and below price.
//    04:00   Mark the high and low of the 03:00-04:00 range.
//    then    Wait for price to sweep the range high or low into one of the
//            marked 15m PD arrays.
//    entry   The first inverse fair value gap (IFVG) on the chart timeframe
//            after that. Put the chart on 30 seconds.
//    exit    Stop beyond the sweep extreme. Target the other side of the range
//            (the opposing liquidity), capped at 3R.
//
//  HOW EACH STEP IS DEFINED
//    15m PD array    A fair value gap, order block or inverse fair value gap on
//                    the 15-minute chart that no 15m candle has closed through.
//                    Bearish arrays are marked above price (for shorts) and
//                    bullish arrays below price (for longs).
//    Sweep           After 04:00 a bar trades beyond the range high or low.
//    Into the array  From the sweep bar on, a bar overlaps a marked array that
//                    is still valid.
//    IFVG            Short: a bar closes below a bullish FVG. Long: a bar closes
//                    above a bearish FVG. The trade is entered at that close.
//    One trade a day. The first side to complete all the steps wins.
//
//  READ THIS FIRST
//    * The IFVG is read from the chart's own timeframe, so use a 30-second
//      chart. Second-based charts need a TradingView plan that includes them.
//      On a 1-minute chart the script still runs and uses 1-minute IFVGs.
//    * The market has to trade between 03:00 and 04:00 New York: futures,
//      forex, crypto. US stocks and ETFs have no bars at that hour.
//    * Alerts: create an alert on this strategy and choose "Order fills and
//      alert() function calls". Put {{strategy.order.alert_message}} in the
//      message box. You then get the 03:55 wake-up, the 04:00 range, the sweep
//      and the entry and exit.
//    * Educational tool, not financial advice.
// ══════════════════════════════════════════════════════════════════════════════
strategy("4AM Range Sweep + 15m PD Array + IFVG", shorttitle = "4AM Sweep IFVG", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0,
     process_orders_on_close = true, calc_on_every_tick = false,
     margin_long = 0, margin_short = 0,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ── Constants ────────────────────────────────────────────────────────────────
const string TZ        = "America/New_York"
const string HTF       = "15"
const int    F         = 6       // numbers kept per 15m array: top, bottom, direction, kind, start time, bar index
const int    KEEP      = 60      // most 15m arrays remembered at once
const int    K_FVG     = 1
const int    K_OB      = 2
const int    K_IFVG    = 3
const string DIR_BOTH  = "Longs & shorts"
const string DIR_LONG  = "Longs only"
const string DIR_SHORT = "Shorts only"
const string SZ_FIX    = "Fixed quantity"
const string SZ_RISK   = "Risk % of equity"
const color  C_BULL    = #26a69a
const color  C_BEAR    = #ef5350
const color  C_RANGE   = #5b9cf6
const color  C_WARN    = #f59f00

// ── Inputs ───────────────────────────────────────────────────────────────────
const string G_TIME = "1 · Times (New York)"
int  wakeH   = input.int(3,  "Mark the 15m PD arrays at", minval = 0, maxval = 23, inline = "wk", group = G_TIME)
int  wakeM   = input.int(55, ":", minval = 0, maxval = 59, inline = "wk", group = G_TIME, tooltip = "The arrays are chosen at this time from 15m candles that have already closed. This is also the wake-up alert.")
int  rsH     = input.int(3,  "Range starts at", minval = 0, maxval = 23, inline = "rs", group = G_TIME)
int  rsM     = input.int(0,  ":", minval = 0, maxval = 59, inline = "rs", group = G_TIME)
int  reH     = input.int(4,  "Range ends, entries start at", minval = 0, maxval = 23, inline = "re", group = G_TIME)
int  reM     = input.int(0,  ":", minval = 0, maxval = 59, inline = "re", group = G_TIME)
int  teH     = input.int(7,  "Stop looking for entries at", minval = 0, maxval = 23, inline = "te", group = G_TIME)
int  teM     = input.int(0,  ":", minval = 0, maxval = 59, inline = "te", group = G_TIME, tooltip = "No new trade is opened after this time. A trade that is already open keeps its stop and target.")
bool useFlat = input.bool(false, "Close an open trade at", inline = "fl", group = G_TIME)
int  flH     = input.int(11, "", minval = 0, maxval = 23, inline = "fl", group = G_TIME)
int  flM     = input.int(0,  ":", minval = 0, maxval = 59, inline = "fl", group = G_TIME, tooltip = "Off: the trade stays open until the stop or the target is hit.")

const string G_PD = "2 · 15-minute PD arrays"
bool  useFvg     = input.bool(true, "Fair value gaps (FVG)", group = G_PD, tooltip = "Three 15m candles where the first and the third do not overlap. The gap between them is the array.")
bool  useOb      = input.bool(true, "Order blocks (OB)", group = G_PD, tooltip = "The last down-close 15m candle before a candle that closes above its high (bullish), or the last up-close candle before a candle that closes below its low (bearish). The array is that candle's high to low.")
bool  useInv     = input.bool(true, "Inverse fair value gaps (IFVG)", group = G_PD, tooltip = "A 15m FVG that a 15m candle has closed through. It flips: a failed bullish gap becomes a bearish array and the other way round.")
int   perSide    = input.int(1, "Arrays to mark on each side", minval = 1, maxval = 3, group = G_PD, tooltip = "1 marks the nearest bearish array above price and the nearest bullish array below price.")
bool  beyondOnly = input.bool(true, "Skip arrays that sit inside the range", group = G_PD, tooltip = "On: an array only counts if it reaches beyond the high or low of the range so far, because a sweep of the range cannot end inside an array that is inside the range. Off: the nearest array to price is used wherever it is.")
float zoneMinAtr = input.float(0.1, "Smallest array height (× 15m ATR)", minval = 0.0, step = 0.05, group = G_PD)
int   zoneMaxAge = input.int(480, "Forget arrays older than (15m candles)", minval = 10, group = G_PD, tooltip = "480 candles is five days of round-the-clock trading.")

const string G_TRADE = "3 · Entry, stop and target"
string dirMode     = input.string(DIR_BOTH, "Trade direction", options = [DIR_BOTH, DIR_LONG, DIR_SHORT], group = G_TRADE)
int    gapMaxAge   = input.int(60, "Entry FVG: forget after (bars)", minval = 3, group = G_TRADE, tooltip = "Only FVGs on the chart timeframe that formed within this many bars can become the entry IFVG. 60 bars is 30 minutes on a 30-second chart.")
int    gapMinTicks = input.int(0, "Entry FVG: smallest size (ticks)", minval = 0, group = G_TRADE)
int    stopTicks   = input.int(1, "Stop: ticks beyond the sweep extreme", minval = 0, group = G_TRADE)
float  maxRR       = input.float(3.0, "Target: cap at (R)", minval = 0.25, step = 0.25, group = G_TRADE, tooltip = "The target is the other side of the range. If that is further than this many R, the target is moved in to exactly this many R.")
float  minRR       = input.float(1.0, "Skip the trade if the target is closer than (R)", minval = 0.0, step = 0.25, group = G_TRADE, tooltip = "0 takes every setup whose target is on the right side of the entry.")
string sizeMode    = input.string(SZ_FIX, "Position size", options = [SZ_FIX, SZ_RISK], group = G_TRADE)
float  fixedQty    = input.float(1.0, "Fixed quantity", minval = 0.0001, group = G_TRADE)
float  riskPct     = input.float(1.0, "Risk per trade (% of equity)", minval = 0.01, step = 0.25, group = G_TRADE, tooltip = "Used when position size is set to risk %. The quantity is sized so that the stop costs this share of equity.")

const string G_VIS = "4 · Display"
bool showRange = input.bool(true, "Range box and levels", group = G_VIS)
bool showZones = input.bool(true, "Marked 15m PD arrays", group = G_VIS)
bool showMarks = input.bool(true, "Step labels (mark, sweep, into array)", group = G_VIS)
bool showTrade = input.bool(true, "Entry, stop and target lines", group = G_VIS)
bool showTable = input.bool(true, "Status table", group = G_VIS)

// ── Types ────────────────────────────────────────────────────────────────────
// A 15m PD array that was marked for today.
type Zone
    float top
    float bot
    int   dir              // +1 bullish (below price, for longs), -1 bearish (above price, for shorts)
    int   kind
    int   born             // open time of the candle that starts the array
    bool  alive  = true    // false once a 15m candle closes through it
    bool  tapped = false   // true once price trades into it after the sweep
    box   bx

// A fair value gap on the chart timeframe.
type Gap
    float top
    float bot
    int   bar
    int   born

type Trade
    int   dir
    float entry
    float stop
    float target
    float rr
    int   bar
    int   flatTs
    bool  live = true
    line  lnEntry
    line  lnStop
    line  lnTarget

// ── Small helpers ────────────────────────────────────────────────────────────
f_px(float v) => str.tostring(v, format.mintick)

f_kind(int kind) => kind == K_FVG ? "FVG" : kind == K_OB ? "OB" : "IFVG"

f_hhmm(int h, int m) => str.tostring(h, "00") + ":" + str.tostring(m, "00")

f_live(Trade t) => na(t) ? false : t.live

// ── 15-minute PD arrays (this part runs inside the 15m timeframe) ────────────
f_addZone(array<float> z, float top, float bot, int dir, int kind, int startTime) =>
    z.push(top)
    z.push(bot)
    z.push(dir)
    z.push(kind)
    z.push(startTime)
    z.push(bar_index)

// Keeps every 15m array that is still valid in one flat list, F numbers per
// array. Returns the list as it stood when the previous 15m candle closed, so
// nothing from a candle that is still forming leaks into the chart.
f_pdArrays(bool trackFvg, bool trackOb, bool flipFvg, float minAtr, int maxAge) =>
    var array<float> z = array.new<float>()
    array<float> before = z.copy()
    float minH = nz(ta.atr(14)) * minAtr
    // 1. Arrays this candle closed through are flipped (FVG to IFVG) or dropped. Old arrays are dropped.
    int i = int(z.size() / F) - 1
    while i >= 0
        int   b       = i * F
        float top     = z.get(b)
        float bot     = z.get(b + 1)
        float dir     = z.get(b + 2)
        float kind    = z.get(b + 3)
        bool  through = dir > 0 ? close < bot : close > top
        bool  tooOld  = bar_index - z.get(b + 5) > maxAge
        if through and flipFvg and kind == K_FVG and not tooOld
            z.set(b + 2, -dir)
            z.set(b + 3, K_IFVG)
        else if through or tooOld
            for k = 1 to F
                z.remove(b)
        i -= 1
    // 2. Arrays this candle created.
    if trackFvg and low > high[2] and low - high[2] >= minH
        f_addZone(z, low, high[2], 1, K_FVG, time[2])
    if trackFvg and high < low[2] and low[2] - high >= minH
        f_addZone(z, low[2], high, -1, K_FVG, time[2])
    if trackOb and close[1] < open[1] and close > high[1] and high[1] - low[1] >= minH
        f_addZone(z, high[1], low[1], 1, K_OB, time[1])
    if trackOb and close[1] > open[1] and close < low[1] and high[1] - low[1] >= minH
        f_addZone(z, high[1], low[1], -1, K_OB, time[1])
    // 3. Keep the list short: the oldest arrays go first.
    while z.size() > KEEP * F
        z.shift()
    before

array<float> pdNow = request.security(syminfo.tickerid, HTF, f_pdArrays(useFvg or useInv, useOb, useInv, zoneMinAtr, zoneMaxAge), lookahead = barmerge.lookahead_on)

// ── Helpers for the marked arrays ────────────────────────────────────────────
f_zoneFrom(array<float> src, int idx) =>
    int b = idx * F
    Zone.new(src.get(b), src.get(b + 1), int(src.get(b + 2)), int(src.get(b + 3)), int(src.get(b + 4)))

f_drawZone(Zone z, int leftMin, int rightTime) =>
    color c = z.dir > 0 ? C_BULL : C_BEAR
    z.bx := box.new(left = math.max(z.born, leftMin), top = z.top, right = rightTime, bottom = z.bot, xloc = xloc.bar_time,
         border_color = color.new(c, 30), bgcolor = color.new(c, 85),
         text = "15m " + f_kind(z.kind), text_size = size.small, text_color = c, text_halign = text.align_right, text_valign = text.align_center)
    z

f_retire(Zone z) =>
    z.alive := false
    if not na(z.bx)
        box.set_bgcolor(z.bx, color.new(color.gray, 92))
        box.set_border_color(z.bx, color.new(color.gray, 60))
        box.set_text_color(z.bx, color.new(color.gray, 30))
        box.set_border_style(z.bx, line.style_dotted)
    z

// Price trades into a marked array that is still valid.
f_tap(array<Zone> zones) =>
    bool hit = false
    for z in zones
        if z.alive and high >= z.bot and low <= z.top
            z.tapped := true
            hit := true
    hit

f_ready(array<Zone> zones) =>
    bool ok = false
    for z in zones
        if z.alive and z.tapped
            ok := true
    ok

f_zoneText(array<Zone> zones) =>
    string s = ""
    for z in zones
        s := s + (s == "" ? "" : ", ") + f_kind(z.kind) + " " + f_px(z.bot) + "-" + f_px(z.top) + (z.alive ? "" : " (closed through)")
    s == "" ? "none" : s

f_row(table t, int r, string k, string v, color c) =>
    table.cell(t, 0, r, k, text_color = color.new(chart.fg_color, 30), text_halign = text.align_left, text_size = size.small)
    table.cell(t, 1, r, v, text_color = c, text_halign = text.align_left, text_size = size.small)

// ── Clock (New York) ─────────────────────────────────────────────────────────
int  yy         = year(time, TZ)
int  mo         = month(time, TZ)
int  dd         = dayofmonth(time, TZ)
int  tsWake     = timestamp(TZ, yy, mo, dd, wakeH, wakeM, 0)
int  tsRngStart = timestamp(TZ, yy, mo, dd, rsH, rsM, 0)
int  tsRngEnd   = timestamp(TZ, yy, mo, dd, reH, reM, 0)
int  tsTradeEnd = timestamp(TZ, yy, mo, dd, teH, teM, 0)
int  tsFlat     = timestamp(TZ, yy, mo, dd, flH, flM, 0)
int  dayKey     = yy * 10000 + mo * 100 + dd
bool newDay     = dayKey != nz(dayKey[1], dayKey)
bool new15      = timeframe.change(HTF)
int  tfSec      = timeframe.in_seconds()

// ── State ────────────────────────────────────────────────────────────────────
var bool  fullDay  = false   // the chart holds this day from before the range started
var float rngHi    = na
var float rngLo    = na
var bool  rngDone  = false
var bool  marked   = false
var bool  sweptHi  = false
var bool  sweptLo  = false
var float extHi    = na      // highest price of the run above the range
var float extLo    = na      // lowest price of the run below the range
var bool  armedS   = false
var bool  armedL   = false
var bool  shortOff = false
var bool  longOff  = false
var bool  traded   = false
var box   rngBox   = na
var Trade trade    = na
var array<Zone> upZones  = array.new<Zone>()
var array<Zone> dnZones  = array.new<Zone>()
var array<Gap>  bullGaps = array.new<Gap>()
var array<Gap>  bearGaps = array.new<Gap>()

if barstate.isfirst
    if tfSec > 900
        runtime.error("Use a chart timeframe of 15 minutes or lower. The model is built for a 30-second chart.")
    if reH * 60 + reM <= rsH * 60 + rsM
        runtime.error("The range has to end after it starts.")
    if teH * 60 + teM <= reH * 60 + reM
        runtime.error("Entries have to stop after the range ends.")
    fullDay := time <= tsRngStart

if newDay
    fullDay  := true
    rngHi    := na
    rngLo    := na
    rngDone  := false
    marked   := false
    sweptHi  := false
    sweptLo  := false
    extHi    := na
    extLo    := na
    armedS   := false
    armedL   := false
    shortOff := false
    longOff  := false
    traded   := false
    rngBox   := na
    upZones.clear()
    dnZones.clear()

// ── Fair value gaps on the chart timeframe (they become the entry IFVG) ──────
Gap invBear = na   // a bullish FVG that this bar closed below: a bearish IFVG
Gap invBull = na   // a bearish FVG that this bar closed above: a bullish IFVG
int gi = bullGaps.size() - 1
while gi >= 0
    Gap g = bullGaps.get(gi)
    if close < g.bot
        if na(invBear)
            invBear := g
        bullGaps.remove(gi)
    else if bar_index - g.bar > gapMaxAge
        bullGaps.remove(gi)
    gi -= 1
gi := bearGaps.size() - 1
while gi >= 0
    Gap g = bearGaps.get(gi)
    if close > g.top
        if na(invBull)
            invBull := g
        bearGaps.remove(gi)
    else if bar_index - g.bar > gapMaxAge
        bearGaps.remove(gi)
    gi -= 1
float gapMin = gapMinTicks * syminfo.mintick
if low > high[2] and low - high[2] >= gapMin
    bullGaps.push(Gap.new(low, high[2], bar_index - 1, time[2]))
if high < low[2] and low[2] - high >= gapMin
    bearGaps.push(Gap.new(low[2], high, bar_index - 1, time[2]))

// ── Step 2 · 03:00-04:00: the range ──────────────────────────────────────────
// (Runs before step 1 so that the 03:55 marking knows the range so far.)
bool inRange = fullDay and not rngDone and time >= tsRngStart and time < tsRngEnd
if inRange
    rngHi := na(rngHi) ? high : math.max(rngHi, high)
    rngLo := na(rngLo) ? low : math.min(rngLo, low)
    if showRange
        if na(rngBox)
            rngBox := box.new(left = time, top = rngHi, right = tsRngEnd, bottom = rngLo, xloc = xloc.bar_time,
                 border_color = color.new(C_RANGE, 40), bgcolor = color.new(C_RANGE, 90),
                 text = f_hhmm(rsH, rsM) + "-" + f_hhmm(reH, reM), text_size = size.small, text_color = color.new(C_RANGE, 20), text_halign = text.align_left, text_valign = text.align_top)
        else
            box.set_top(rngBox, rngHi)
            box.set_bottom(rngBox, rngLo)

bool rangeSetNow = fullDay and not rngDone and not na(rngHi) and time_close >= tsRngEnd
if rangeSetNow
    rngDone := true
    if showRange
        line.new(tsRngEnd, rngHi, tsTradeEnd, rngHi, xloc = xloc.bar_time, color = C_RANGE, style = line.style_dashed)
        line.new(tsRngEnd, rngLo, tsTradeEnd, rngLo, xloc = xloc.bar_time, color = C_RANGE, style = line.style_dashed)
    alert(syminfo.ticker + " " + f_hhmm(reH, reM) + " NY: the range is set. High " + f_px(rngHi) + ", low " + f_px(rngLo) + ". Wait for a sweep into a marked 15m PD array.", alert.freq_once_per_bar_close)

// ── Step 1 · 03:55: mark the nearest 15m PD arrays ───────────────────────────
bool markNow = fullDay and not marked and time_close >= tsWake and time < tsTradeEnd
if markNow
    marked := true
    float refHi = beyondOnly and not na(rngHi) ? rngHi : close
    float refLo = beyondOnly and not na(rngLo) ? rngLo : close
    if not na(pdNow)
        int n = int(pdNow.size() / F)
        array<float> upDist = array.new<float>()
        array<int>   upIdx  = array.new<int>()
        array<float> dnDist = array.new<float>()
        array<int>   dnIdx  = array.new<int>()
        int zi = 0
        while zi < n
            int   b      = zi * F
            float top    = pdNow.get(b)
            float bot    = pdNow.get(b + 1)
            float dir    = pdNow.get(b + 2)
            float kind   = pdNow.get(b + 3)
            bool  wanted = kind == K_FVG ? useFvg : kind == K_OB ? useOb : useInv
            if wanted and dir < 0 and top > refHi
                upDist.push(math.max(bot - close, 0.0))
                upIdx.push(zi)
            else if wanted and dir > 0 and bot < refLo
                dnDist.push(math.max(close - top, 0.0))
                dnIdx.push(zi)
            zi += 1
        int leftMin = tsWake - 12 * 60 * 60 * 1000
        if upDist.size() > 0
            array<int> upOrd = upDist.sort_indices(order.ascending)
            int k = 0
            while k < math.min(perSide, upOrd.size())
                Zone z = f_zoneFrom(pdNow, upIdx.get(upOrd.get(k)))
                if showZones
                    f_drawZone(z, leftMin, tsTradeEnd)
                upZones.push(z)
                k += 1
        if dnDist.size() > 0
            array<int> dnOrd = dnDist.sort_indices(order.ascending)
            int k = 0
            while k < math.min(perSide, dnOrd.size())
                Zone z = f_zoneFrom(pdNow, dnIdx.get(dnOrd.get(k)))
                if showZones
                    f_drawZone(z, leftMin, tsTradeEnd)
                dnZones.push(z)
                k += 1
    if showMarks
        label.new(bar_index, high, f_hhmm(wakeH, wakeM) + " mark", style = label.style_label_down, color = color.new(C_WARN, 20), textcolor = color.white, size = size.tiny)
    alert(syminfo.ticker + " " + f_hhmm(wakeH, wakeM) + " NY: mark the nearest 15m PD arrays. Above: " + f_zoneText(upZones) + ". Below: " + f_zoneText(dnZones) + ".", alert.freq_once_per_bar_close)

// A 15m candle has just closed: retire marked arrays it closed through.
if marked and new15
    for z in upZones
        if z.alive and close[1] > z.top
            f_retire(z)
    for z in dnZones
        if z.alive and close[1] < z.bot
            f_retire(z)

// ── Open trade: follow it to the stop, the target or the time exit ───────────
if f_live(trade) and bar_index > trade.bar
    bool hitStop = trade.dir > 0 ? low <= trade.stop : high >= trade.stop
    bool hitTp   = trade.dir > 0 ? high >= trade.target : low <= trade.target
    bool timeUp  = useFlat and time_close >= trade.flatTs
    if showTrade
        line.set_x2(trade.lnEntry, bar_index)
        line.set_x2(trade.lnStop, bar_index)
        line.set_x2(trade.lnTarget, bar_index)
    if hitStop or hitTp or timeUp
        trade.live := false
        float  r   = hitStop ? -1.0 : hitTp ? trade.rr : trade.dir * (close - trade.entry) / math.abs(trade.entry - trade.stop)
        string why = hitStop ? "Stop" : hitTp ? "Target" : "Time exit"
        if not hitStop and not hitTp
            strategy.close_all(comment = "Time exit", alert_message = syminfo.ticker + " 4AM model: time exit, close the trade at " + f_px(close))
        if showTrade
            bool above = hitStop ? trade.dir < 0 : trade.dir > 0
            label.new(bar_index, above ? high : low, why + " " + (r > 0 ? "+" : "") + str.tostring(r, "0.0") + "R", style = above ? label.style_label_down : label.style_label_up, color = color.new(r > 0 ? C_BULL : C_BEAR, 20), textcolor = color.white, size = size.small)

// ── Step 3 · after 04:00: sweep of the range into a marked array ─────────────
bool hunting = rngDone and not traded and time >= tsRngEnd and time < tsTradeEnd
if hunting
    if high > rngHi
        if not sweptHi and showMarks
            label.new(bar_index, high, "Range high swept", style = label.style_label_down, color = color.new(C_BEAR, 40), textcolor = color.white, size = size.tiny)
        sweptHi := true
        extHi   := na(extHi) ? high : math.max(extHi, high)
    if low < rngLo
        if not sweptLo and showMarks
            label.new(bar_index, low, "Range low swept", style = label.style_label_up, color = color.new(C_BULL, 40), textcolor = color.white, size = size.tiny)
        sweptLo := true
        extLo   := na(extLo) ? low : math.min(extLo, low)
    if sweptHi
        f_tap(upZones)
    if sweptLo
        f_tap(dnZones)

bool readyS = hunting and sweptHi and not shortOff and dirMode != DIR_LONG and f_ready(upZones)
bool readyL = hunting and sweptLo and not longOff and dirMode != DIR_SHORT and f_ready(dnZones)

if readyS and not armedS
    armedS := true
    if showMarks
        label.new(bar_index, high, "Into 15m array\nwait for bearish IFVG", style = label.style_label_down, color = color.new(C_BEAR, 20), textcolor = color.white, size = size.small)
    alert(syminfo.ticker + " 4AM model: range high " + f_px(rngHi) + " swept into a 15m PD array (" + f_zoneText(upZones) + "). Watch for the first bearish IFVG to go short.", alert.freq_once_per_bar_close)
if readyL and not armedL
    armedL := true
    if showMarks
        label.new(bar_index, low, "Into 15m array\nwait for bullish IFVG", style = label.style_label_up, color = color.new(C_BULL, 20), textcolor = color.white, size = size.small)
    alert(syminfo.ticker + " 4AM model: range low " + f_px(rngLo) + " swept into a 15m PD array (" + f_zoneText(dnZones) + "). Watch for the first bullish IFVG to go long.", alert.freq_once_per_bar_close)

// ── Step 4 · the first IFVG: entry, stop and target ──────────────────────────
int  sig      = readyS and not na(invBear) ? -1 : readyL and not na(invBull) ? 1 : 0
bool canEnter = strategy.position_size == 0 and not f_live(trade)
if sig != 0 and canEnter
    bool  isLong = sig > 0
    Gap   gap    = isLong ? invBull : invBear
    float tick   = syminfo.mintick
    float stop   = math.round_to_mintick(isLong ? extLo - stopTicks * tick : extHi + stopTicks * tick)
    float risk   = isLong ? close - stop : stop - close
    float liq    = isLong ? rngHi : rngLo
    float capped = isLong ? close + maxRR * risk : close - maxRR * risk
    float target = math.round_to_mintick(isLong ? math.min(liq, capped) : math.max(liq, capped))
    float rr     = risk > 0 ? (isLong ? target - close : close - target) / risk : 0.0
    if risk > 0 and rr > 0 and rr >= minRR
        string id   = isLong ? "Long" : "Short"
        string side = isLong ? "LONG" : "SHORT"
        string plan = "entry " + f_px(close) + ", stop " + f_px(stop) + ", target " + f_px(target) + " (" + str.tostring(rr, "0.0") + "R)"
        float  qty  = sizeMode == SZ_RISK ? strategy.equity * riskPct / 100 / (risk * syminfo.pointvalue) : fixedQty
        strategy.entry(id, isLong ? strategy.long : strategy.short, qty = qty, alert_message = syminfo.ticker + " 4AM model: " + side + " after the first IFVG, " + plan)
        strategy.exit(id + " exit", from_entry = id, stop = stop, limit = target,
             alert_profit = syminfo.ticker + " 4AM model: " + side + " target hit at " + f_px(target),
             alert_loss = syminfo.ticker + " 4AM model: " + side + " stopped out at " + f_px(stop))
        trade  := Trade.new(sig, close, stop, target, rr, bar_index, tsFlat)
        traded := true
        if showTrade
            color c = isLong ? C_BULL : C_BEAR
            box.new(left = gap.born, top = gap.top, right = time_close, bottom = gap.bot, xloc = xloc.bar_time,
                 border_color = color.new(c, 20), bgcolor = color.new(c, 75),
                 text = "IFVG", text_size = size.tiny, text_color = c, text_halign = text.align_left, text_valign = text.align_center)
            trade.lnEntry  := line.new(bar_index, close, bar_index + 1, close, color = color.new(chart.fg_color, 30), style = line.style_dotted)
            trade.lnStop   := line.new(bar_index, stop, bar_index + 1, stop, color = C_BEAR, width = 2)
            trade.lnTarget := line.new(bar_index, target, bar_index + 1, target, color = C_BULL, width = 2)
            label.new(bar_index, isLong ? low : high, side + " " + f_px(close) + "\nSL " + f_px(stop) + " · TP " + f_px(target) + " (" + str.tostring(rr, "0.0") + "R)", style = isLong ? label.style_label_up : label.style_label_down, color = color.new(c, 0), textcolor = color.white, size = size.small)
    else
        // The first IFVG came too far from the sweep extreme or too close to the target: no trade on this side today.
        if isLong
            longOff := true
        else
            shortOff := true
        if showMarks
            label.new(bar_index, isLong ? low : high, "IFVG skipped\ntarget " + str.tostring(rr, "0.0") + "R away", style = isLong ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny)

// ── Data window ──────────────────────────────────────────────────────────────
plot(rngHi, "Range high", color = C_RANGE, display = display.data_window)
plot(rngLo, "Range low", color = C_RANGE, display = display.data_window)

// ── Status table ─────────────────────────────────────────────────────────────
if showTable and barstate.islast
    var table dash = table.new(position.top_right, 2, 7, bgcolor = color.new(chart.bg_color, 10), frame_color = color.new(chart.fg_color, 70), frame_width = 1, border_color = color.new(chart.fg_color, 90), border_width = 1)
    color  fg = chart.fg_color
    string st = "Waiting for the " + f_hhmm(rsH, rsM) + "-" + f_hhmm(reH, reM) + " range"
    color  sc = fg
    if f_live(trade)
        st := "In a trade"
        sc := trade.dir > 0 ? C_BULL : C_BEAR
    else if traded
        st := "Done for today"
    else if not rngDone and not na(rngHi)
        st := "Range is forming"
    else if rngDone and time >= tsTradeEnd
        st := "Entry window is closed"
    else if readyS and readyL
        st := "Both sides armed: waiting for the first IFVG"
        sc := C_WARN
    else if readyS
        st := "Armed SHORT: waiting for a bearish IFVG"
        sc := C_BEAR
    else if readyL
        st := "Armed LONG: waiting for a bullish IFVG"
        sc := C_BULL
    else if rngDone and (sweptHi or sweptLo)
        st := "Range swept: waiting for price to reach a 15m array"
        sc := C_WARN
    else if rngDone
        st := "Waiting for a sweep of the range"
    f_row(dash, 0, "4AM Sweep IFVG", str.format_time(time, "EEE HH:mm", TZ) + " New York", fg)
    f_row(dash, 1, "Range", na(rngHi) ? "not set" : "high " + f_px(rngHi) + " · low " + f_px(rngLo), fg)
    f_row(dash, 2, "15m array above", marked ? f_zoneText(upZones) : "marked at " + f_hhmm(wakeH, wakeM), C_BEAR)
    f_row(dash, 3, "15m array below", marked ? f_zoneText(dnZones) : "marked at " + f_hhmm(wakeH, wakeM), C_BULL)
    f_row(dash, 4, "Status", st, sc)
    f_row(dash, 5, "Last trade", na(trade) ? "none" : (trade.dir > 0 ? "LONG " : "SHORT ") + f_px(trade.entry) + " · SL " + f_px(trade.stop) + " · TP " + f_px(trade.target) + " (" + str.tostring(trade.rr, "0.0") + "R)", fg)
    if tfSec != 30
        table.cell(dash, 0, 6, "Chart is not on 30 seconds. The IFVG entry is read from this chart's timeframe.", text_color = C_WARN, text_halign = text.align_left, text_size = size.small)
        table.merge_cells(dash, 0, 6, 1, 6)
